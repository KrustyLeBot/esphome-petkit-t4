wifi_ssid: 'SSID'
wifi_password: 'pass'

ap_ssid: 'Petkit T4'
ap_password: 'petkit-t4'

ota_password: 'secret'

api_encryption_key: ""  # Generate here: https://esphome.io/components/api/#configuration-variables

# Login of the web API and status page (Homey's petkit-t4 driver uses it).

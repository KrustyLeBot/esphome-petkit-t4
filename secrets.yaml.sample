# PETKIT K3 smart spray paired with this box: its Bluetooth MAC and its secret (hex), read once from
# the Petkit cloud before leaving it (README, "Deodorizer"). Leave the secret empty if you have no K3.
k3_mac: '00:00:00:00:00:00'
k3_secret: ''
